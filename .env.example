# .env.example — copy to .env and fill in

# LLM
MAG_GEMINI_API_KEY=
MAG_GEMINI_MODEL=gemini-2.5-flash
MAG_OPENAI_API_KEY=
MAG_ANTHROPIC_API_KEY=
MAG_DEFAULT_PROVIDER=gemini
# Max attempts per Gemini call; transient 429s are retried with exponential backoff (1 = no retry).
MAG_GEMINI_MAX_ATTEMPTS=5

# Vertex AI backend for Gemini (ADC). Set MAG_GEMINI_USE_VERTEX=true to use Vertex
# instead of the direct Gemini Developer API key above.
MAG_GEMINI_USE_VERTEX=false
MAG_GCP_PROJECT=
# Endpoint region: 'global' (best availability) or a region to switch endpoints / for data
# residency, e.g. us-central1, northamerica-northeast1 (Montréal), northamerica-northeast2 (Toronto).
# Regions can have different quota/capacity than 'global' if you hit persistent 429s.
MAG_GCP_LOCATION=global
# Path to the service-account JSON key (exported to GOOGLE_APPLICATION_CREDENTIALS).
MAG_GCP_CREDENTIALS_PATH=

MAG_DATA_DIR=./data
MAG_EXPORTS_DIR=./exports

# GPU
MAG_GPU_SSH_ALIAS=gpu
MAG_GPU_REMOTE_WORKDIR=/scratch/marker_runs
MAG_GPU_CONDA_ENV=dl
MAG_GPU_MARKER_DIR=/scratch/marker_runs/format_conversion

MAG_HOST=127.0.0.1
MAG_PORT=8000
